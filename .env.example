# Copy to .env and fill in. Never commit .env.

# Use fake versions of every external service (true until your keys work)
USE_MOCKS=true
# live = call Claude; fixture = labeled pre-extracted fixtures (works without a key, shown as 'fixture' in the UI)
AI_MODE=fixture

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Pick a model available to your account
ANTHROPIC_MODEL=

# Factory Droid
FACTORY_API_KEY=

# SpacetimeDB
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DATABASE=countersign
# One identity per role; filled in by scripts/setup_actors.py
SPACETIMEDB_ADMIN_TOKEN=
SPACETIMEDB_AGENT_TOKEN=
SPACETIMEDB_GATEWAY_TOKEN=
SPACETIMEDB_SYNC_TOKEN=

# Web app (put these in web/.env.local instead):
# NEXT_PUBLIC_SPACETIMEDB_URI, NEXT_PUBLIC_SPACETIMEDB_DATABASE,
# SPACETIMEDB_OWNER_TOKEN, SPACETIMEDB_BOOKKEEPER_TOKEN, SPACETIMEDB_PURCHASING_TOKEN,
# SPACETIMEDB_RECEIVER_TOKEN, DEMO_PIN,
# NEXT_PUBLIC_CORE_URL=http://localhost:8000

# Capital One Nessie
NESSIE_API_KEY=

# CRS sandbox
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api
CRS_USERNAME=
CRS_PASSWORD=

# Apify
APIFY_TOKEN=
APIFY_LICENSE_ACTOR=
APIFY_DIESEL_ACTOR=

# Gmail intake (should-have)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Cartesia (stretch)
CARTESIA_API_KEY=
